#!/bin/sh -e

# ─────────────────────────────────────────────────────────────────────────────
# snap/hooks/install — runs once on first install
#
# Creates the HERMES_HOME directory, seeds empty config files, and sets
# default snap configuration keys so 'snap get all-dev-hermesagent' works immediately.
# ─────────────────────────────────────────────────────────────────────────────

# Create the all-dev-hermesagent home directory with empty config files
mkdir -p "$SNAP_COMMON"
touch "$SNAP_COMMON/.env"
touch "$SNAP_COMMON/config.yaml"
chmod 644 "$SNAP_COMMON/.env"
chmod 644 "$SNAP_COMMON/config.yaml"

# Set default snap configuration keys
snapctl set agent-service="disabled"
snapctl set acp-service="disabled"
snapctl set dashboard-service="enabled"
snapctl set gateway-service="disabled"
snapctl set model="gpt-4o"
snapctl set log-level="info"

# CT integration defaults (empty until configured by Control Tower)
snapctl set ct-callback-url=""
snapctl set ct-snap-name=""
snapctl set ct-node-id=""
snapctl set ct-deployment-id=""

echo "Hermes installed successfully."
echo ""
echo "Configure via:  sudo snap set all-dev-hermesagent openrouter-api-key=sk-or-..."
echo "Dashboard:      http://<device-ip>:9119"
echo ""
echo "Optional interface connections:"
echo "  snap connect all-dev-hermesagent:home"
echo "  snap connect all-dev-hermesagent:dot-hermes"
echo "  snap connect all-dev-hermesagent:ssh-keys"
echo "  snap connect all-dev-hermesagent:removable-media"
