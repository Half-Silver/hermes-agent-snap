#!/bin/sh -e
# snap/hooks/configure — bridges snap set to .env and config.yaml

export HERMES_HOME="$SNAP_COMMON"
export PATH="$SNAP/bin:$SNAP/usr/bin:$PATH"

# 1. Ensure files exist and are world-readable
mkdir -p "$SNAP_COMMON"
ENV_FILE="$SNAP_COMMON/.env"
CONFIG_FILE="$SNAP_COMMON/config.yaml"

touch "$ENV_FILE" "$CONFIG_FILE"
chmod 644 "$ENV_FILE" "$CONFIG_FILE"

# Helper to directly update .env
update_env() {
    key="$1"
    snap_key="$2"
    value=$(snapctl get "$snap_key")
    if [ -n "$value" ]; then
        # Remove existing and append
        sed -i "/^${key}=/d" "$ENV_FILE"
        echo "${key}=${value}" >> "$ENV_FILE"
    fi
}

# Helper to update config.yaml via hermes CLI
update_config() {
    key="$1"
    snap_key="$2"
    value=$(snapctl get "$snap_key")
    if [ -n "$value" ]; then
        "$SNAP/bin/hermes" config set "$key" "$value" 2>/dev/null || true
    fi
}

# --- LLM Provider Keys (.env) ---
update_env "OPENAI_API_KEY"         "openai-api-key"
update_env "OPENAI_BASE_URL"        "openai-base-url"
update_env "OPENROUTER_API_KEY"     "openrouter-api-key"
update_env "ANTHROPIC_API_KEY"      "anthropic-api-key"
update_env "GEMINI_API_KEY"         "gemini-api-key"
update_env "DEEPSEEK_API_KEY"       "deepseek-api-key"
update_env "XAI_API_KEY"            "xai-api-key"

# --- Messaging (.env) ---
update_env "TELEGRAM_BOT_TOKEN"     "telegram-bot-token"
update_env "TELEGRAM_ALLOWED_USERS" "telegram-allowed-users"
update_env "DISCORD_BOT_TOKEN"      "discord-bot-token"
update_env "DISCORD_ALLOWED_USERS"  "discord-allowed-users"
update_env "SLACK_BOT_TOKEN"        "slack-bot-token"
update_env "SLACK_APP_TOKEN"        "slack-app-token"

# --- Tools (.env) ---
update_env "EXA_API_KEY"            "exa-api-key"
update_env "TAVILY_API_KEY"         "tavily-api-key"
update_env "FIRECRAWL_API_KEY"      "firecrawl-api-key"

# --- Dashboard auth (basic username/password) ---
# A non-loopback dashboard bind ALWAYS requires an auth provider (the
# June-2026 hardening; --insecure is a no-op). Configure one here and the
# dashboard service binds 0.0.0.0; leave it unset and it stays on loopback.
#
#   snap set <snap> dashboard-username=admin dashboard-password=<password>
#
# The plaintext password is hashed with the bundled scrypt helper and then
# dropped from snap config — only the hash is persisted (.env is 0644).
DASH_USER=$(snapctl get dashboard-username 2>/dev/null || true)
DASH_PW=$(snapctl get dashboard-password 2>/dev/null || true)
DASH_PW_HASH=$(snapctl get dashboard-password-hash 2>/dev/null || true)
DASH_SECRET=$(snapctl get dashboard-session-secret 2>/dev/null || true)

write_env_kv() {
    key="$1"
    val="$2"
    sed -i "/^${key}=/d" "$ENV_FILE"
    if [ -n "$val" ]; then
        echo "${key}=${val}" >> "$ENV_FILE"
    fi
}

if [ -n "$DASH_PW" ]; then
    # Hash on stdin so the plaintext never appears in the process table.
    NEW_HASH=$(printf '%s' "$DASH_PW" | "$SNAP/bin/python3" -c 'import sys
from plugins.dashboard_auth.basic import hash_password
print(hash_password(sys.stdin.read()))' 2>/dev/null || true)
    if [ -n "$NEW_HASH" ]; then
        DASH_PW_HASH="$NEW_HASH"
        snapctl set dashboard-password-hash="$NEW_HASH" 2>/dev/null || true
        snapctl unset dashboard-password 2>/dev/null || true
    else
        echo "warning: could not hash dashboard-password — dashboard auth unchanged" >&2
    fi
fi

if [ -n "$DASH_USER" ] && [ -n "$DASH_PW_HASH" ] && [ -z "$DASH_SECRET" ]; then
    # Stable token-signing key so logins survive a dashboard restart.
    DASH_SECRET=$(head -c 32 /dev/urandom | base64 | tr -d '\n=' | tr '+/' '-_')
    snapctl set dashboard-session-secret="$DASH_SECRET" 2>/dev/null || true
fi

write_env_kv "HERMES_DASHBOARD_BASIC_AUTH_USERNAME"      "$DASH_USER"
write_env_kv "HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH" "$DASH_PW_HASH"
write_env_kv "HERMES_DASHBOARD_BASIC_AUTH_SECRET"        "$DASH_SECRET"

# --- Settings (config.yaml) ---
update_config "model"            "model"
update_config "model.provider"   "model-provider"
update_config "model.name"       "model-name"
update_config "logging.level"    "log-level"

# Ensure permissions are preserved
chmod 644 "$ENV_FILE" "$CONFIG_FILE"

# --- Service Control ---
# enabled/disabled are explicit operator overrides. For `gateway-service` the
# value `auto` (the default) is intentionally a no-op here — the gateway is then
# governed by reconcile-services below, which starts it iff a messaging token is
# configured. agent/acp/dashboard remain straightforward on/off toggles.
handle_service() {
    snap_key="$1"
    service_name="$2"
    val=$(snapctl get "$snap_key")
    if [ "$val" = "enabled" ]; then
        snapctl start --enable "all-dev-hermesagent.$service_name"
    elif [ "$val" = "disabled" ]; then
        snapctl stop --disable "all-dev-hermesagent.$service_name"
    fi
}

handle_service "agent-service"          "agent"
handle_service "acp-service"            "acp"
handle_service "gateway-service"        "gateway"
handle_service "dashboard-service"      "dashboard"
handle_service "config-watcher-service" "config-watcher"

# Re-read dashboard credentials / bind host without a manual restart.
# Only touches an already-running dashboard, so this never starts a service
# the operator deliberately disabled.
if snapctl services all-dev-hermesagent.dashboard 2>/dev/null \
    | awk 'NR>1 && $3 == "active" { found = 1 } END { exit !found }'; then
    snapctl restart all-dev-hermesagent.dashboard 2>/dev/null || true
fi

# CT Engine
CT_URL=$(snapctl get ct-callback-url)
if [ -n "$CT_URL" ]; then
    snapctl start --enable all-dev-hermesagent.ct-engine
    snapctl restart all-dev-hermesagent.ct-engine
fi

# --- Reconcile services to the freshly-written config ---
# Brings the gateway up/down to match configured messaging tokens (and reloads
# it so new tokens connect). Same code path the config-watcher daemon runs for
# web-UI-driven changes, so `snap set` and the dashboard stay consistent.
if [ -x "$SNAP/bin/reconcile-services" ]; then
    "$SNAP/bin/reconcile-services" || true
fi

echo "Configuration applied successfully."
