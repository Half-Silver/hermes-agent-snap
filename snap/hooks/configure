#!/bin/sh -e

# ─────────────────────────────────────────────────────────────────────────────
# snap/hooks/configure — runs on every 'snap set hermes ...'
#
# Bridges snap configuration to hermes' own 'config set' command, which
# automatically routes API keys to .env and settings to config.yaml.
# ─────────────────────────────────────────────────────────────────────────────

# Point HERMES_HOME at the snap-writable common directory so hermes writes
# config.yaml and .env to /var/snap/hermes/common/
export HERMES_HOME="$SNAP_COMMON"
export PATH="$SNAP/bin:$SNAP/usr/bin:$PATH"

# Ensure the hermes home directory exists
mkdir -p "$SNAP_COMMON"

# Helper: read a snap key and pass it to 'hermes config set'
# Usage: apply_config <snap-key> <hermes-config-key>
apply_config() {
    snap_key="$1"
    hermes_key="$2"
    value=$(snapctl get "$snap_key")
    if [ -n "$value" ]; then
        "$SNAP/bin/hermes" config set "$hermes_key" "$value" 2>/dev/null || true
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# 1. LLM Provider API Keys → .env
# ─────────────────────────────────────────────────────────────────────────────
apply_config "openai-api-key"       "OPENAI_API_KEY"
apply_config "openai-base-url"      "OPENAI_BASE_URL"
apply_config "openrouter-api-key"   "OPENROUTER_API_KEY"
apply_config "anthropic-api-key"    "ANTHROPIC_API_KEY"
apply_config "gemini-api-key"       "GEMINI_API_KEY"
apply_config "deepseek-api-key"     "DEEPSEEK_API_KEY"
apply_config "xai-api-key"          "XAI_API_KEY"
apply_config "ollama-base-url"      "OLLAMA_BASE_URL"

# ─────────────────────────────────────────────────────────────────────────────
# 2. Tool API Keys → .env
# ─────────────────────────────────────────────────────────────────────────────
apply_config "exa-api-key"              "EXA_API_KEY"
apply_config "tavily-api-key"           "TAVILY_API_KEY"
apply_config "firecrawl-api-key"        "FIRECRAWL_API_KEY"
apply_config "browserbase-api-key"      "BROWSERBASE_API_KEY"
apply_config "browserbase-project-id"   "BROWSERBASE_PROJECT_ID"

# ─────────────────────────────────────────────────────────────────────────────
# 3. Messaging Platform Tokens → .env
# ─────────────────────────────────────────────────────────────────────────────
apply_config "telegram-bot-token"       "TELEGRAM_BOT_TOKEN"
apply_config "telegram-allowed-users"   "TELEGRAM_ALLOWED_USERS"
apply_config "discord-bot-token"        "DISCORD_BOT_TOKEN"
apply_config "discord-allowed-users"    "DISCORD_ALLOWED_USERS"
apply_config "slack-bot-token"          "SLACK_BOT_TOKEN"
apply_config "slack-app-token"          "SLACK_APP_TOKEN"

# ─────────────────────────────────────────────────────────────────────────────
# 4. Model & Settings → config.yaml
# ─────────────────────────────────────────────────────────────────────────────
apply_config "model"            "model"
apply_config "model-provider"   "model.provider"
apply_config "model-name"       "model.name"
apply_config "personality"      "personality"
apply_config "log-level"        "logging.level"

# ─────────────────────────────────────────────────────────────────────────────
# 5. File Permissions
# Readable by all users on this device (isolated edge node, no multi-user)
# ─────────────────────────────────────────────────────────────────────────────
chmod 644 "$SNAP_COMMON/.env" 2>/dev/null || true
chmod 644 "$SNAP_COMMON/config.yaml" 2>/dev/null || true

# ─────────────────────────────────────────────────────────────────────────────
# 6. Service Control
# ─────────────────────────────────────────────────────────────────────────────
AGENT_SERVICE=$(snapctl get agent-service)
if [ "$AGENT_SERVICE" = "enabled" ]; then
    snapctl start --enable hermes.agent
elif [ "$AGENT_SERVICE" = "disabled" ]; then
    snapctl stop --disable hermes.agent
fi

ACP_SERVICE=$(snapctl get acp-service)
if [ "$ACP_SERVICE" = "enabled" ]; then
    snapctl start --enable hermes.acp
elif [ "$ACP_SERVICE" = "disabled" ]; then
    snapctl stop --disable hermes.acp
fi

# Dashboard is the ONLY user interface — default to enabled on first install
DASHBOARD_SERVICE=$(snapctl get dashboard-service)
if [ -z "$DASHBOARD_SERVICE" ]; then
    DASHBOARD_SERVICE="enabled"
    snapctl set dashboard-service=enabled
fi
if [ "$DASHBOARD_SERVICE" = "enabled" ]; then
    snapctl start --enable hermes.dashboard
elif [ "$DASHBOARD_SERVICE" = "disabled" ]; then
    snapctl stop --disable hermes.dashboard
fi

# ─────────────────────────────────────────────────────────────────────────────
# 7. CT Engine Integration
# ─────────────────────────────────────────────────────────────────────────────
CT_CALLBACK_URL=$(snapctl get ct-callback-url)
if [ -n "$CT_CALLBACK_URL" ]; then
    snapctl start --enable hermes.ct-engine 2>/dev/null || true
    snapctl restart hermes.ct-engine 2>/dev/null || true
fi

echo "Hermes configuration updated."
