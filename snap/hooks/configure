#!/bin/sh -e

# This hook runs when 'snap set' is called or during installation.
# It reads settings from the snap configuration and updates the Hermes environment/config.

CONFIG_FILE="$SNAP_USER_COMMON/config.yaml"
ENV_FILE="$SNAP_USER_COMMON/.env"

# Ensure the directory exists
mkdir -p "$SNAP_USER_COMMON"

# Helper to update key-value pairs in .env
update_env() {
    key=$1
    val_key=$2
    value=$(snapctl get "$val_key")
    if [ -n "$value" ]; then
        if grep -q "^$key=" "$ENV_FILE" 2>/dev/null; then
            # Escape value for sed
            escaped_value=$(echo "$value" | sed 's/[&/]/\\&/g')
            sed -i "s|^$key=.*|$key=$escaped_value|" "$ENV_FILE"
        else
            echo "$key=$value" >> "$ENV_FILE"
        fi
    fi
}

# Helper to update config.yaml (very basic append/replace for shell)
update_config() {
    key=$1
    val_key=$2
    value=$(snapctl get "$val_key")
    if [ -n "$value" ]; then
        if [ ! -f "$CONFIG_FILE" ]; then
            echo "model: \"\"" > "$CONFIG_FILE"
        fi
        if grep -q "^$key:" "$CONFIG_FILE" 2>/dev/null; then
             # Simple replace for top-level keys
             sed -i "s|^$key:.*|$key: \"$value\"|" "$CONFIG_FILE"
        else
             echo "$key: \"$value\"" >> "$CONFIG_FILE"
        fi
    fi
}

# 1. Main LLM Providers
update_env "OPENAI_API_KEY" "openai-api-key"
update_env "OPENAI_BASE_URL" "openai-base-url"
update_env "ANTHROPIC_API_KEY" "anthropic-api-key"
update_env "GEMINI_API_KEY" "gemini-api-key"
update_env "DEEPSEEK_API_KEY" "deepseek-api-key"
update_env "XAI_API_KEY" "xai-api-key"
update_env "OLLAMA_BASE_URL" "ollama-base-url"

# 2. Tool APIs
update_env "EXA_API_KEY" "exa-api-key"
update_env "TAVILY_API_KEY" "tavily-api-key"
update_env "FIRECRAWL_API_KEY" "firecrawl-api-key"
update_env "BROWSERBASE_API_KEY" "browserbase-api-key"
update_env "BROWSERBASE_PROJECT_ID" "browserbase-project-id"

# 3. Messaging Platforms
update_env "TELEGRAM_BOT_TOKEN" "telegram-bot-token"
update_env "TELEGRAM_ALLOWED_USERS" "telegram-allowed-users"
update_env "DISCORD_BOT_TOKEN" "discord-bot-token"
update_env "DISCORD_ALLOWED_USERS" "discord-allowed-users"
update_env "SLACK_BOT_TOKEN" "slack-bot-token"
update_env "SLACK_APP_TOKEN" "slack-app-token"

# 4. Global Settings (config.yaml)
update_config "model" "model"
update_config "personality" "personality"

# 5. Service Control
# Allows enabling/disabling background services via 'snap set'
# Valid values: "enabled", "disabled"
AGENT_SERVICE=$(snapctl get agent-service)
if [ "$AGENT_SERVICE" = "enabled" ]; then
    snapctl start --enable hermes-agent.agent
elif [ "$AGENT_SERVICE" = "disabled" ]; then
    snapctl stop --disable hermes-agent.agent
fi

ACP_SERVICE=$(snapctl get acp-service)
if [ "$ACP_SERVICE" = "enabled" ]; then
    snapctl start --enable hermes-agent.acp
elif [ "$ACP_SERVICE" = "disabled" ]; then
    snapctl stop --disable hermes-agent.acp
fi

DASHBOARD_SERVICE=$(snapctl get dashboard-service)
if [ "$DASHBOARD_SERVICE" = "enabled" ]; then
    snapctl start --enable hermes-agent.dashboard
elif [ "$DASHBOARD_SERVICE" = "disabled" ]; then
    snapctl stop --disable hermes-agent.dashboard
fi

# Handle nested config like logging.level (simplified as top-level if needed or skipped for now)
LOG_LEVEL=$(snapctl get log-level)
if [ -n "$LOG_LEVEL" ]; then
    # Ensure logging section exists
    if ! grep -q "^logging:" "$CONFIG_FILE" 2>/dev/null; then
        echo "logging:" >> "$CONFIG_FILE"
        echo "  level: \"$LOG_LEVEL\"" >> "$CONFIG_FILE"
    else
        # This is a bit risky with sed in multi-line yaml, 
        # but works if logging is at the end or uniquely identified.
        sed -i "/^logging:/,/^[^ ]/ s/level:.*/level: \"$LOG_LEVEL\"/" "$CONFIG_FILE"
    fi
fi

# Ensure files have proper permissions inside the snap area
chmod 600 "$ENV_FILE" 2>/dev/null || true

echo "Hermes Snap configuration successfully updated via hook."
