#!/bin/bash

# Set the path for bundled Playwright browsers
export PLAYWRIGHT_BROWSERS_PATH="$SNAP/usr/share/playwright"

# Set the path for bundled Camoufox engine
export CAMOUFOX_DIR="$SNAP/usr/share/camoufox"

# Tell the Python backend where the dashboard web assets are located
export HERMES_WEB_DIST="$SNAP/hermes_cli/web_dist"

# Ensure the Snap's bin and usr/bin are at the front of the PATH
# This ensures bundled node, git, ripgrep, etc. are found first.
export PATH="$SNAP/bin:$SNAP/usr/bin:$PATH"

# Set HERMES_HOME to a writable location in the Snap's user data
# This is where config.yaml, .env, and skills will be stored.
export HERMES_HOME="$SNAP_USER_COMMON"

# If the user has a .hermes in their home, and the dot-hermes plug is connected,
# we might want to prioritize it, but Snap's strict confinement usually 
# makes $SNAP_USER_COMMON a better default for persistence across updates.
if [ -d "$HOME/.hermes" ]; then
    export HERMES_HOME_PERSISTENT="$HOME/.hermes"
fi

# Handle custom service wrappers
if [ "$1" = "dashboard-service" ]; then
    # Try to get the local IP, fallback to 0.0.0.0
    LOCAL_IP=$(hostname -I | awk '{print $1}')
    if [ -z "$LOCAL_IP" ]; then
        LOCAL_IP="0.0.0.0"
    fi
    echo "the agent web ui is live at http://$LOCAL_IP:9119"
    exec "$SNAP/bin/hermes" dashboard --host 0.0.0.0
fi

if [ "$1" = "stop-message" ]; then
    echo "got cmd to stop, goodbye!"
    exit 0
fi

# Run the requested command
exec "$SNAP/bin/$@"
