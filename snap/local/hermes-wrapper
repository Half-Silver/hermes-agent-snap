#!/bin/bash

# Set the path for bundled Playwright browsers
export PLAYWRIGHT_BROWSERS_PATH="$SNAP/usr/share/playwright"

# Set the path for bundled Camoufox engine
export CAMOUFOX_DIR="$SNAP/usr/share/camoufox"

# Tell the Python backend where the dashboard web assets are located
export HERMES_WEB_DIST="$SNAP/hermes_cli/web_dist"

# Ensure the Snap's bin and usr/bin are at the front of the PATH
export PATH="$SNAP/bin:$SNAP/usr/bin:$PATH"

# Set HERMES_HOME to a writable location in the Snap's common data
# Use SNAP_COMMON for daemons so they share the same config/state
export HERMES_HOME="$SNAP_COMMON"



# Define the stop message handler
# This function is triggered by SIGTERM (from snap stop)
handle_stop() {
    echo "got cmd to stop, goodbye!"
    # Ensure the stop message is emitted, then allow exit
    exit 0
}

# Trap SIGTERM for background services
# This ensures the goodbye message is printed when systemd kills the wrapper
trap handle_stop SIGTERM

# Handle custom service wrappers
if [ "$1" = "dashboard-service" ]; then
    # Bind host selection.
    #
    # Since the June-2026 hardening, ANY non-loopback bind requires a
    # registered DashboardAuthProvider — `--insecure` is now a no-op and
    # `start_server` exits instead of serving (that is why the daemon was
    # dying on `--host 0.0.0.0 --insecure`). So: bind all interfaces only
    # when dashboard credentials are configured, otherwise stay on loopback
    # (where the gate never engages) instead of crash-looping.
    #
    # Override with:  snap set <snap> dashboard-host=0.0.0.0|127.0.0.1
    ENV_FILE="$SNAP_COMMON/.env"
    CONFIG_FILE="$SNAP_COMMON/config.yaml"

    has_dashboard_auth() {
        # Env surface — written by the configure hook from `snap set`.
        if grep -qE '^HERMES_DASHBOARD_(BASIC_AUTH_USERNAME|OAUTH_CLIENT_ID)=[^[:space:]]' \
            "$ENV_FILE" 2>/dev/null; then
            return 0
        fi
        # config.yaml surface — written by `hermes dashboard`'s interactive
        # setup and by `hermes dashboard register` (OAuth).
        "$SNAP/bin/python3" - "$CONFIG_FILE" >/dev/null 2>&1 <<'PY'
import sys
try:
    import yaml
    with open(sys.argv[1]) as fh:
        cfg = yaml.safe_load(fh) or {}
except Exception:
    sys.exit(1)
dash = cfg.get("dashboard") or {}
basic = dash.get("basic_auth") or {}
ok = bool(basic.get("username")) and bool(basic.get("password_hash") or basic.get("password"))
sys.exit(0 if ok else 1)
PY
    }

    HOST="$(snapctl get dashboard-host 2>/dev/null || true)"
    if [ -z "$HOST" ]; then
        if has_dashboard_auth; then
            HOST="0.0.0.0"
        else
            HOST="127.0.0.1"
        fi
    fi

    if [ "$HOST" = "0.0.0.0" ] || [ "$HOST" = "::" ]; then
        LOCAL_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
        if [ -z "$LOCAL_IP" ]; then
            LOCAL_IP="$HOST"
        fi
        echo "the agent web ui is live at http://$LOCAL_IP:9119 (sign in with your dashboard password)"
    else
        echo "the agent web ui is live at http://$HOST:9119 (loopback only — no password set)"
        echo "  expose it on the LAN:  sudo snap set ${SNAP_NAME:-all-dev-hermesagent} dashboard-username=admin dashboard-password=<password>"
        echo "  or keep it local:      ssh -L 9119:127.0.0.1:9119 <this-host>"
    fi

    # No --insecure: it no longer bypasses the auth gate, it only logs a warning.
    "$SNAP/bin/hermes" dashboard --host "$HOST" &
    wait $!
    exit 0
fi

if [ "$1" = "gateway-service" ]; then
    echo "starting hermes messaging gateway..."
    "$SNAP/bin/hermes" gateway run --replace &
    wait $!
    exit 0
fi

if [ "$1" = "config-watcher" ]; then
    # Bridges web-UI config writes (.env/config.yaml) to snap service lifecycle.
    echo "starting hermes config-watcher (applies web-UI config changes)..."
    "$SNAP/bin/config-watcher" &
    wait $!
    exit 0
fi

# Run the requested command in the background so the trap can catch signals
# 'exec' would replace the shell and lose the trap, so we run & and wait
"$SNAP/bin/$@" &
wait $!
